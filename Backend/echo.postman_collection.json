{
  "info": {
    "_postman_id": "e7a4f9c2-5b1d-4d8e-9f03-123456789abc",
    "name": "Echo API",
    "description": "Postman collection for the Echo chat backend. Run '01 - Create conversation' first: its test script stores the new id in the conversationId collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "nonexistentConversationId",
      "value": "999999999"
    }
  ],
  "item": [
    {
      "name": "Conversations",
      "item": [
        {
          "name": "01 - Create conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Response contains a conversation id', function () {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "});",
                  "",
                  "if (body.id) {",
                  "  pm.collectionVariables.set('conversationId', body.id);",
                  "  console.log('Saved conversationId =', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations"
              ]
            },
            "description": "Creates an empty conversation. The returned id is saved automatically for the following requests."
          },
          "response": []
        },
        {
          "name": "02 - List conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations"
              ]
            },
            "description": "Returns every conversation, newest first."
          },
          "response": []
        },
        {
          "name": "03 - Delete conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{conversationId}}"
              ]
            },
            "description": "Deletes the current conversation and, through ON DELETE CASCADE, all of its messages."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "04 - Send first message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('User and assistant messages were returned', function () {",
                  "  pm.expect(body.user_message.role).to.eql('user');",
                  "  pm.expect(body.assistant_message.role).to.eql('assistant');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Tell me a one-liner programming joke\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{conversationId}}",
                "messages"
              ]
            },
            "description": "Saves the user's message, sends the conversation history to OpenAI, and returns both stored messages."
          },
          "response": []
        },
        {
          "name": "05 - Send contextual follow-up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Echo returned an assistant message', function () {",
                  "  pm.expect(body.assistant_message.content).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"still one-liner, but change the subject\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{conversationId}}",
                "messages"
              ]
            },
            "description": "Demonstrates context retention: the server reloads the previous joke from MySQL before calling OpenAI."
          },
          "response": []
        },
        {
          "name": "06 - Get conversation history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{conversationId}}",
                "messages"
              ]
            },
            "description": "Returns the whole history of one conversation in chronological order, ready for a page refresh restore."
          },
          "response": []
        },
        {
          "name": "07 - Missing conversation returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Response contains a clear detail message', function () {",
                  "  pm.expect(pm.response.json().detail).to.include('was not found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"This conversation does not exist\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{nonexistentConversationId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{nonexistentConversationId}}",
                "messages"
              ]
            },
            "description": "Error example: sending a message to a conversation that does not exist returns 404 with a JSON detail."
          },
          "response": []
        }
      ]
    }
  ]
}
