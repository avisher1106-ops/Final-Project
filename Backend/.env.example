# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file to source control.

# OpenAI (server-side only)
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=echo_db

# Optional: maximum number of previous messages sent to OpenAI per request
MAX_HISTORY_MESSAGES=20
